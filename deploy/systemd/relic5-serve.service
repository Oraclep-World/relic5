# relic5 hub on `main` (user pleamvelli): MCP + read API on loopback only, one token per machine.
# A systemd *user* unit runs as the user who installs it (pleamvelli here), so there is no User= line.
# From agent-relic-v3 hub/systemd/relic3-serve.service (6a6d9d8). The tokens live in ~/.config/relic5/tokens (0600),
# never in this file; serve refuses to start without one.
#   cp deploy/systemd/relic5-serve.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now relic5-serve
[Unit]
Description=relic5 hub: MCP and read API for every machine (loopback for now)
After=network-online.target tailscaled.service

[Service]
Environment=RELIC5_ROOT=%h/relic5
ExecStart=%h/relic5/app/.venv/bin/relic5 serve --root %h/relic5 --host 127.0.0.1 --port 8795
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
